# Ghost 博客系统环境配置示例
# 复制此文件为 .env 并根据实际环境修改

# ============================================
# 基础配置
# ============================================

# 运行环境：development / production
NODE_ENV=development

# 服务端口（默认2368）
PORT=2368

# 站点URL（本地开发用localhost，生产环境用实际域名）
URL=http://localhost:2368

# ============================================
# 数据库配置（SQLite）
# ============================================

# 数据库类型：sqlite3 / mysql
DB_CLIENT=sqlite3

# SQLite数据库文件路径（相对于runtime目录）
DB_FILENAME=content/data/ghost.db

# ============================================
# MySQL配置（仅当DB_CLIENT=mysql时使用）
# ============================================

# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=ghost
# DB_PASSWORD=your_password
# DB_NAME=ghost_production

# ============================================
# 邮件服务配置
# ============================================

# 邮件传输方式：SMTP / Direct
MAIL_TRANSPORT=SMTP

# SMTP服务器地址（本地开发用127.0.0.1假SMTP服务器）
MAIL_HOST=127.0.0.1

# SMTP端口（本地假SMTP用2525，真实SMTP通常用587或465）
MAIL_PORT=2525

# SMTP用户名（真实SMTP服务需要）
# MAIL_USER=your_email@example.com

# SMTP密码（真实SMTP服务需要）
# MAIL_PASS=your_password

# ============================================
# 安全配置
# ============================================

# 管理员新设备登录验证：true / false
# 本地开发建议设为false，避免每次登录需要邮件验证码
STAFF_DEVICE_VERIFICATION=false

# 管理员登录密码重置有效期（小时）
# ADMIN_PASSWORD_RESET_TTL=24

# ============================================
# 管理员账号（首次初始化使用）
# ============================================

# 管理员邮箱
ADMIN_EMAIL=admin@example.com

# 管理员密码（至少10位，包含字母和数字）
ADMIN_PASSWORD=your_admin_password

# 管理员姓名
ADMIN_NAME=Admin

# ============================================
# 主题配置
# ============================================

# 默认主题名称
DEFAULT_THEME=oss-blog-theme

# 主题源码目录（相对于项目根目录）
THEME_SOURCE_DIR=theme/oss-blog-theme

# ============================================
# 备份配置
# ============================================

# 备份目录（相对于项目根目录）
BACKUP_DIR=backups

# 内容导出目录（相对于项目根目录）
EXPORT_DIR=dist

# ============================================
# 注意事项
# ============================================
# 1. 此文件仅为示例，实际配置请复制为 .env 后修改
# 2. .env 文件包含敏感信息，已加入 .gitignore，不会提交到Git
# 3. 生产环境请务必修改默认密码和启用STAFF_DEVICE_VERIFICATION
# 4. 真实邮件服务请配置有效的SMTP服务器和账号
# 5. Windows环境下路径分隔符使用反斜杠\
