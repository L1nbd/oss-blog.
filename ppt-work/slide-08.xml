    <shape type="text" topLeftX="60" topLeftY="345" width="840" height="30">
      <content textType="body" fontSize="13" color="rgba(191,215,255,1)" textAlign="center">
        <p>window.addEventListener('scroll', function() { ... })  监听滚动事件</p>
      </content>
    </shape>
    <line startX="480" startY="390" endX="480" endY="410">
      <border color="rgba(13,19,38,1)" width="2"/>
      <endArrow type="arrow"/>
    </line>
    <shape type="rect" topLeftX="40" topLeftY="410" width="880" height="60">
      <fill><fillColor color="rgba(37,99,235,1)"/></fill>
    </shape>
    <shape type="text" topLeftX="60" topLeftY="425" width="840" height="30">
      <content textType="body" fontSize="13" color="rgba(255,255,255,1)" textAlign="center">
        <p>progress = window.scrollY / (document.body.scrollHeight - window.innerHeight) * 100</p>
      </content>
    </shape>
    <line startX="480" startY="470" endX="480" endY="490">
      <border color="rgba(13,19,38,1)" width="2"/>
      <endArrow type="arrow"/>
